---
/**
 * Drop-in replacement for `<img src="/images/...">`.
 *
 * Resolves the public URL to the imported source file and renders Astro's
 * `<Image>` with a WebP srcset, `sizes`, and intrinsic width/height. If the
 * file isn't in the build-time index (GIFs, ignored folders) it renders a
 * plain `<img>` with the same attributes so nothing breaks.
 */
import type { HTMLAttributes } from 'astro/types';
import { Image } from 'astro:assets';
import {
  resolveImage,
  pickWidths,
  SIZES,
  WIDTHS,
  type ImagePreset,
} from '../lib/responsive-images';

interface Props extends Omit<HTMLAttributes<'img'>, 'src' | 'alt' | 'width' | 'height' | 'sizes'> {
  src: string;
  alt: string;
  /** Picks default `widths` + `sizes`. Override either explicitly if needed. */
  preset?: ImagePreset;
  widths?: readonly number[];
  sizes?: string;
  quality?: number;
}

const {
  src,
  alt,
  preset = 'grid',
  widths = WIDTHS[preset],
  sizes = SIZES[preset],
  quality = 78,
  loading = 'lazy',
  decoding = 'async',
  ...rest
} = Astro.props;

const meta = resolveImage(src);

const srcsetWidths = meta ? pickWidths(widths, meta.width) : [];
const fallbackWidth = srcsetWidths.at(-1) ?? meta?.width ?? 0;
const fallbackHeight = meta ? Math.round((fallbackWidth * meta.height) / meta.width) : 0;
---

{
  meta ? (
    <Image
      src={meta}
      alt={alt}
      format="webp"
      quality={quality}
      width={fallbackWidth}
      height={fallbackHeight}
      widths={srcsetWidths}
      sizes={sizes}
      loading={loading}
      decoding={decoding}
      {...rest}
    />
  ) : (
    <img src={src} alt={alt} loading={loading} decoding={decoding} {...rest} />
  )
}
