---
/**
 * Drop-in replacement for `<img src="/images/...">`.
 *
 * Resolves the public URL to the imported source file and renders Astro's
 * `<Image>` with a WebP srcset, `sizes`, and intrinsic width/height.
 *
 * GIFs with a generated MP4 (see scripts/encode-media.mjs) render as a muted,
 * looping, inline `<video>` with a poster instead, which is a fraction of the
 * weight. Anything else not in the build-time index falls back to a plain
 * `<img>` with the same attributes so nothing breaks.
 */
import type { HTMLAttributes } from 'astro/types';
import { Image } from 'astro:assets';
import {
  resolveImage,
  pickWidths,
  SIZES,
  WIDTHS,
  type ImagePreset,
} from '../lib/responsive-images';
import { gifVideoFor } from '../lib/derived-media';

interface Props extends Omit<HTMLAttributes<'img'>, 'src' | 'alt' | 'width' | 'height' | 'sizes'> {
  src: string;
  alt: string;
  /** Picks default `widths` + `sizes`. Override either explicitly if needed. */
  preset?: ImagePreset;
  widths?: readonly number[];
  sizes?: string;
  quality?: number;
}

const {
  src,
  alt,
  preset = 'grid',
  widths = WIDTHS[preset],
  sizes = SIZES[preset],
  quality = 78,
  loading = 'lazy',
  decoding = 'async',
  ...rest
} = Astro.props;

const video = gifVideoFor(src);
const meta = video ? undefined : resolveImage(src);

const srcsetWidths = meta ? pickWidths(widths, meta.width) : [];
const fallbackWidth = srcsetWidths.at(-1) ?? meta?.width ?? 0;
const fallbackHeight = meta ? Math.round((fallbackWidth * meta.height) / meta.width) : 0;

// <video> has no alt; surface the description to assistive tech instead.
const { fetchpriority: _fetchpriority, draggable: _draggable, ...videoRest } = rest as Record<string, unknown>;
---

{
  video ? (
    <video
      src={video.src}
      poster={video.poster}
      width={video.width}
      height={video.height}
      autoplay
      muted
      loop
      playsinline
      preload={loading === 'eager' ? 'auto' : 'metadata'}
      aria-label={alt || undefined}
      aria-hidden={alt ? undefined : 'true'}
      data-autoplay-muted="true"
      {...videoRest}
    />
  ) : meta ? (
    <Image
      src={meta}
      alt={alt}
      format="webp"
      quality={quality}
      width={fallbackWidth}
      height={fallbackHeight}
      widths={srcsetWidths}
      sizes={sizes}
      loading={loading}
      decoding={decoding}
      {...rest}
    />
  ) : (
    <img src={src} alt={alt} loading={loading} decoding={decoding} {...rest} />
  )
}
