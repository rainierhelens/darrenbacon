---
import { publications } from '../data/publications';

const items = publications;
const coverUrl = (image: string) => `/images/book_publications/${encodeURIComponent(image)}`;
---

{
  items.length > 0 && (
    <section class="mx-auto max-w-7xl px-6 py-16 lg:px-8">
      <h2 class="text-2xl font-semibold tracking-tight" data-reveal>
        Publications
      </h2>
      <p class="mt-3 max-w-2xl text-sm leading-relaxed text-muted" data-reveal>
        Featured and contributing artist across official art books for Halo, Destiny, and Star Wars,
        plus design-industry titles from Design Studio Press.
      </p>
      <ul class="mt-8 grid grid-cols-2 gap-5 sm:grid-cols-3 lg:grid-cols-4">
        {items.map((item, index) => {
          const Tag = item.href ? 'a' : 'div';
          return (
            <li data-reveal data-reveal-stagger style={`--reveal-delay: ${(index % 4) * 70}ms`}>
              <Tag
                {...(item.href
                  ? { href: item.href, target: '_blank', rel: 'noopener noreferrer' }
                  : {})}
                class="spotlight group flex h-full flex-col overflow-hidden rounded-xl border border-border/60 bg-surface transition duration-300 hover:-translate-y-1 hover:border-accent/50 hover:shadow-2xl hover:shadow-black/40"
              >
                <div class="sheen flex aspect-[3/4] items-center justify-center overflow-hidden bg-surface-elevated p-2">
                  <img
                    src={coverUrl(item.image)}
                    alt={`${item.title} cover`}
                    loading="lazy"
                    decoding="async"
                    class="h-full w-full object-contain transition duration-700 group-hover:scale-105"
                  />
                </div>
                <div class="relative z-10 flex flex-1 flex-col p-4">
                  <span class="text-[0.65rem] tracking-[0.15em] uppercase text-accent">{item.role}</span>
                  <span class="mt-1.5 text-sm font-medium leading-snug transition-colors group-hover:text-accent">
                    {item.title}
                  </span>
                  <span class="mt-auto pt-2 text-xs text-muted">
                    {item.publisher} · {item.year}
                  </span>
                </div>
              </Tag>
            </li>
          );
        })}
      </ul>
    </section>
  )
}
