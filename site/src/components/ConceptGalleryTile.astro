---
import GalleryTileRotator from './GalleryTileRotator.astro';
import { getGalleryRotationImages } from '../lib/concept-gallery';

interface Props {
  slug: string;
  label: string;
  description: string;
  count?: number;
  staggerIndex?: number;
}

const { slug, label, description, count, staggerIndex = 0 } = Astro.props;
const images = getGalleryRotationImages(slug);
const interval = 5000 + staggerIndex * 700;
---

<a
  href={`/concept/${slug}`}
  class="group overflow-hidden rounded-2xl border border-border/60 bg-surface transition hover:border-accent/40"
>
  <div class="aspect-[4/3] overflow-hidden bg-surface-elevated">
    <GalleryTileRotator
      images={images}
      alt={label}
      interval={interval}
      class="transition duration-700 group-hover:scale-105"
    />
  </div>
  <div class:list={['p-5', count !== undefined && 'flex items-start justify-between gap-4']}>
    <div>
      <h2 class:list={['font-medium', count !== undefined ? 'text-xl' : 'text-lg']}>{label}</h2>
      <p class="mt-2 text-sm text-muted">{description}</p>
    </div>
    {
      count !== undefined && (
        <span class="shrink-0 text-xs tracking-wide text-muted">{count}</span>
      )
    }
  </div>
</a>
