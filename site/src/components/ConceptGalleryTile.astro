---
import GalleryTileRotator from './GalleryTileRotator.astro';
import { getGalleryRotationImages } from '../lib/concept-gallery';

interface Props {
  slug: string;
  label: string;
  description: string;
  count?: number;
  staggerIndex?: number;
}

const { slug, label, description, count, staggerIndex = 0 } = Astro.props;
const images = getGalleryRotationImages(slug);
const interval = 5000 + staggerIndex * 700;
---

<a
  href={`/concept/${slug}`}
  data-reveal
  data-reveal-stagger
  style={`--reveal-delay: ${(staggerIndex % 6) * 80}ms`}
  class="spotlight group overflow-hidden rounded-2xl border border-border/60 bg-surface transition duration-300 hover:-translate-y-1 hover:border-accent/50 hover:shadow-2xl hover:shadow-black/40"
>
  <div class="sheen aspect-[4/3] overflow-hidden bg-surface-elevated">
    <GalleryTileRotator
      images={images}
      alt={label}
      interval={interval}
      class="transition duration-700 group-hover:scale-105"
    />
  </div>
  <div class:list={['relative z-10 p-5', count !== undefined && 'flex items-start justify-between gap-4']}>
    <div>
      <h2 class:list={['font-medium transition-colors group-hover:text-accent', count !== undefined ? 'text-xl' : 'text-lg']}>{label}</h2>
      <p class="mt-2 text-sm text-muted">{description}</p>
      <span class="mt-3 inline-flex items-center gap-1 text-xs font-medium tracking-wide text-accent opacity-0 transition-all duration-300 group-hover:opacity-100">
        View gallery
        <span class="inline-block transition-transform duration-300 group-hover:translate-x-1">→</span>
      </span>
    </div>
    {
      count !== undefined && (
        <span class="shrink-0 text-xs tracking-wide text-muted">{count}</span>
      )
    }
  </div>
</a>
