---
import GalleryTileRotator from './GalleryTileRotator.astro';

interface Props {
  href: string;
  studio: string;
  title: string;
  description: string;
  images: string[];
  staggerIndex?: number;
  wide?: boolean;
}

const { href, studio, title, description, images, staggerIndex = 0, wide = false } = Astro.props;
const interval = 5000 + staggerIndex * 700;
---

<a
  href={href}
  class:list={[
    'group overflow-hidden rounded-2xl border border-border/60 bg-surface transition hover:border-accent/40',
    wide && 'lg:col-span-2',
  ]}
>
  <div class="aspect-video overflow-hidden bg-surface-elevated">
    <GalleryTileRotator
      images={images}
      alt={title}
      interval={interval}
      class="transition duration-700 group-hover:scale-105"
    />
  </div>
  <div class="p-6">
    <p class="text-xs tracking-[0.2em] uppercase text-accent">{studio}</p>
    <h2 class="mt-2 text-2xl font-medium">{title}</h2>
    <p class="mt-3 text-sm leading-relaxed text-muted">{description}</p>
    <span class="mt-5 inline-flex text-sm text-accent">View case study →</span>
  </div>
</a>
