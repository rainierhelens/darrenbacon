---
import GalleryTileRotator from './GalleryTileRotator.astro';

interface Props {
  href: string;
  studio: string;
  title: string;
  description: string;
  images: string[];
  staggerIndex?: number;
  wide?: boolean;
}

const { href, studio, title, description, images, staggerIndex = 0, wide = false } = Astro.props;
const interval = 5000 + staggerIndex * 700;
---

<a
  href={href}
  data-reveal
  data-reveal-stagger
  style={`--reveal-delay: ${(staggerIndex % 6) * 80}ms`}
  class:list={[
    'spotlight group overflow-hidden rounded-2xl border border-border/60 bg-surface transition duration-300 hover:-translate-y-1 hover:border-accent/50 hover:shadow-2xl hover:shadow-black/40',
    wide && 'lg:col-span-2',
  ]}
>
  <div class="sheen aspect-video overflow-hidden bg-surface-elevated">
    <GalleryTileRotator
      images={images}
      alt={title}
      interval={interval}
      class="transition duration-700 group-hover:scale-105"
    />
  </div>
  <div class="relative z-10 p-6">
    <p class="text-xs tracking-[0.2em] uppercase text-accent">{studio}</p>
    <h2 class="mt-2 text-2xl font-medium transition-colors group-hover:text-accent">{title}</h2>
    <p class="mt-3 text-sm leading-relaxed text-muted">{description}</p>
    <span class="mt-5 inline-flex items-center gap-1.5 text-sm text-accent">
      View case study
      <span class="inline-block transition-transform duration-300 group-hover:translate-x-1">→</span>
    </span>
  </div>
</a>
