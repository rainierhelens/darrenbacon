---
import { GA_MEASUREMENT_ID, CLARITY_PROJECT_ID } from '../config/features';

const gaId = GA_MEASUREMENT_ID.trim();
const clarityId = CLARITY_PROJECT_ID.trim();
const hasGa = Boolean(gaId);
const hasClarity = Boolean(clarityId);
---

{
  hasGa && (
    <>
      <script async src={`https://www.googletagmanager.com/gtag/js?id=${gaId}`} />
      <script is:inline define:vars={{ gaId }}>
        window.dataLayer = window.dataLayer || [];
        function gtag() {
          dataLayer.push(arguments);
        }
        window.gtag = gtag;
        gtag('js', new Date());
        // Astro ClientRouter fires astro:page-load on first paint and every soft nav —
        // disable the default hit so we don't double-count.
        gtag('config', gaId, { send_page_view: false });

        const trackPageView = () => {
          gtag('event', 'page_view', {
            page_title: document.title,
            page_location: location.href,
            page_path: location.pathname + location.search,
          });
        };

        trackPageView();
        document.addEventListener('astro:page-load', trackPageView);
      </script>
    </>
  )
}

{
  hasClarity && (
    <script is:inline define:vars={{ clarityId }}>
      (function (c, l, a, r, i, t, y) {
        c[a] =
          c[a] ||
          function () {
            (c[a].q = c[a].q || []).push(arguments);
          };
        t = l.createElement(r);
        t.async = 1;
        t.src = 'https://www.clarity.ms/tag/' + i;
        y = l.getElementsByTagName(r)[0];
        y.parentNode.insertBefore(t, y);
      })(window, document, 'clarity', 'script', clarityId);
    </script>
  )
}
