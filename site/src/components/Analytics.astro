---
import { GA_MEASUREMENT_ID, CLARITY_PROJECT_ID } from '../config/features';

const gaId = GA_MEASUREMENT_ID.trim();
const clarityId = CLARITY_PROJECT_ID.trim();
const hasGa = Boolean(gaId);
const hasClarity = Boolean(clarityId);
---

{
  hasGa && (
    <>
      <script async src={`https://www.googletagmanager.com/gtag/js?id=${gaId}`} />
      <script is:inline define:vars={{ gaId }}>
        window.dataLayer = window.dataLayer || [];
        function gtag() {
          dataLayer.push(arguments);
        }
        window.gtag = gtag;
        gtag('js', new Date());
        // Disable the automatic hit. ClientRouter emits astro:page-load on first
        // paint *and* every soft nav; a second immediate trackPageView() was
        // double-counting the landing page.
        gtag('config', gaId, { send_page_view: false });

        const canonicalPath = () => {
          let path = location.pathname;
          if (path.length > 1 && !path.endsWith('/') && !/\.[a-z0-9]+$/i.test(path)) {
            path += '/';
          }
          return path + location.search;
        };

        const trackPageView = () => {
          const pagePath = canonicalPath();
          if (window.__gaPagePath === pagePath) return;
          window.__gaPagePath = pagePath;
          gtag('event', 'page_view', {
            page_title: document.title,
            page_location: location.origin + pagePath,
            page_path: pagePath,
          });
        };

        document.addEventListener('astro:page-load', trackPageView);
        // /brief/ has no ClientRouter, so astro:page-load never fires there.
        trackPageView();
      </script>
    </>
  )
}

{
  hasClarity && (
    <script is:inline define:vars={{ clarityId }}>
      (function (c, l, a, r, i, t, y) {
        c[a] =
          c[a] ||
          function () {
            (c[a].q = c[a].q || []).push(arguments);
          };
        t = l.createElement(r);
        t.async = 1;
        t.src = 'https://www.clarity.ms/tag/' + i;
        y = l.getElementsByTagName(r)[0];
        y.parentNode.insertBefore(t, y);
      })(window, document, 'clarity', 'script', clarityId);
    </script>
  )
}
