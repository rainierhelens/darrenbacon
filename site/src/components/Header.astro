---
import { nav, site, socialLinks } from '../data/site';
import { RESUME_URL, RESUME_LABEL, resumeAvailable } from '../config/features';

const currentPath = Astro.url.pathname;
---

<header class="sticky top-0 z-50 border-b border-border/60 bg-bg/80 backdrop-blur-xl">
  <div class="mx-auto flex max-w-7xl items-center justify-between px-6 py-4 lg:px-8">
    <a href="/" class="group flex items-center gap-3">
      <img
        src="/images/icon_animation_60pix_transparent.gif"
        alt=""
        width="36"
        height="36"
        class="h-9 w-9 shrink-0"
        decoding="async"
        aria-hidden="true"
      />
      <span class="flex flex-col gap-0.5">
        <span class="text-sm font-semibold tracking-[0.2em] uppercase text-fg transition-colors group-hover:text-accent">
          {site.name}
        </span>
        <span class="text-xs text-muted">{site.tagline}</span>
      </span>
    </a>

    <nav class="hidden items-center gap-8 md:flex" aria-label="Main navigation">
      {
        nav.map((item) => {
          const isActive =
            currentPath === item.href ||
            (item.href !== '/' && currentPath.startsWith(item.href));
          return (
            <a
              href={item.href}
              data-nav-link
              class:list={[
                'nav-link text-sm tracking-wide uppercase transition-colors',
                isActive ? 'is-active text-accent' : 'text-muted hover:text-fg',
              ]}
            >
              <span class="nav-label" data-label={item.label}>{item.label}</span>
            </a>
          );
        })
      }
    </nav>

    <div class="hidden items-center gap-6 sm:flex">
      <a
        href={socialLinks[1].href}
        target="_blank"
        rel="noopener noreferrer"
        class="text-sm text-muted transition-colors hover:text-accent"
      >
        {site.handle}
      </a>
      {
        resumeAvailable && (
          <a
            href={RESUME_URL}
            class="rounded-full border border-border px-4 py-1.5 text-sm tracking-wide transition hover:border-accent hover:text-accent"
          >
            {RESUME_LABEL}
          </a>
        )
      }
    </div>

    <button
      id="mobile-menu-btn"
      type="button"
      class="inline-flex h-10 w-10 items-center justify-center rounded-md border border-border text-fg md:hidden"
      aria-label="Open menu"
      aria-expanded="false"
    >
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
        <path d="M4 7h16M4 12h16M4 17h16" stroke-linecap="round" />
      </svg>
    </button>
  </div>

  <nav
    id="mobile-menu"
    class="hidden border-t border-border/60 bg-surface px-6 py-4 md:hidden"
    aria-label="Mobile navigation"
  >
    <div class="flex flex-col gap-4">
      {
        nav.map((item) => (
          <a href={item.href} class="text-sm tracking-wide uppercase text-muted transition-colors hover:text-fg">
            {item.label}
          </a>
        ))
      }
    </div>
  </nav>
</header>

<style>
  /* Pixel-stepped underline: quantized blocks fill in under the link. */
  .nav-link {
    position: relative;
    padding-bottom: 2px;
  }

  .nav-link::after {
    content: '';
    position: absolute;
    left: 0;
    bottom: -4px;
    height: 3px;
    width: 0%;
    background-image: repeating-linear-gradient(
      to right,
      var(--color-accent) 0 4px,
      transparent 4px 7px
    );
    transition: width 0.28s steps(7, end);
  }

  .nav-link:hover::after,
  .nav-link.is-active::after {
    width: 100%;
  }

  .nav-link.is-clicked::after {
    animation: nav-pixel-scatter 0.18s steps(3, end);
  }

  .nav-label {
    display: inline-block;
  }

  @keyframes nav-pixel-scatter {
    0% { opacity: 1; transform: translateY(0); }
    33% { opacity: 0.35; transform: translateY(-2px); }
    66% { opacity: 0.75; transform: translateY(1px); }
    100% { opacity: 1; transform: none; }
  }

  @media (prefers-reduced-motion: reduce) {
    .nav-link::after {
      transition: none;
    }
    .nav-link.is-clicked::after {
      animation: none;
    }
  }
</style>

<script>
  /** One-pass decode scramble: glyphs resolve left-to-right into the label. */
  const GLYPHS = '!<>-_\\/[]{}=+*^?#ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789';
  const timers = new WeakMap<HTMLElement, number>();

  function scrambleLabel(el: HTMLElement) {
    const label = el.dataset.label;
    if (!label) return;

    const prev = timers.get(el);
    if (prev !== undefined) window.clearInterval(prev);

    // Lock width so neighbors never shift while glyphs cycle.
    el.style.width = `${el.offsetWidth}px`;

    const tickMs = 32;
    const totalTicks = 9;
    let tick = 0;

    const timer = window.setInterval(() => {
      tick += 1;
      const resolved = Math.floor((tick / totalTicks) * label.length);
      el.textContent = label
        .split('')
        .map((char, i) => {
          if (char === ' ' || i < resolved) return char;
          return GLYPHS[Math.floor(Math.random() * GLYPHS.length)];
        })
        .join('');

      if (tick >= totalTicks) {
        window.clearInterval(timer);
        timers.delete(el);
        el.textContent = label;
        el.style.width = '';
      }
    }, tickMs);

    timers.set(el, timer);
  }

  function initNavEffects() {
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    document.querySelectorAll<HTMLAnchorElement>('[data-nav-link]').forEach((link) => {
      const labelEl = link.querySelector<HTMLElement>('.nav-label');

      link.onmouseenter = () => {
        if (!reduced && labelEl) scrambleLabel(labelEl);
      };

      link.onclick = () => {
        link.classList.remove('is-clicked');
        // Force a reflow so the scatter animation can restart on repeat clicks.
        void link.offsetWidth;
        link.classList.add('is-clicked');
      };
    });
  }

  initNavEffects();
  document.addEventListener('astro:page-load', initNavEffects);
</script>

<script>
  function initMobileMenu() {
    const btn = document.getElementById('mobile-menu-btn');
    const menu = document.getElementById('mobile-menu');
    if (!btn || !menu) return;

    const setOpen = (open: boolean) => {
      menu.classList.toggle('hidden', !open);
      btn.setAttribute('aria-expanded', String(open));
      btn.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
    };

    // Reset after client navigations so the drawer doesn't stay open.
    setOpen(false);

    btn.onclick = () => {
      setOpen(menu.classList.contains('hidden'));
    };

    menu.querySelectorAll('a').forEach((link) => {
      (link as HTMLAnchorElement).onclick = () => setOpen(false);
    });
  }

  initMobileMenu();
  document.addEventListener('astro:page-load', initMobileMenu);
</script>
