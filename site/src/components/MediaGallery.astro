---
type GalleryMedia = {
  src: string;
  caption?: string;
  type: 'image' | 'video';
  hero?: boolean;
};

interface Props {
  items: GalleryMedia[];
  altPrefix?: string;
  groupId?: string;
  layout?: 'grid' | 'wide';
  /** Muted looping autoplay (e.g. Marathon gallery clips). */
  autoplayMuted?: boolean;
}

const {
  items,
  altPrefix = 'Artwork',
  groupId = `media-${items.length}-${items[0]?.src.slice(-24).replace(/\W/g, '') ?? 'gallery'}`,
  layout = 'grid',
  autoplayMuted = false,
} = Astro.props;

let imageIndex = 0;
---

<section class="w-full" data-lightbox-group={groupId}>
  {
    items.length > 0 && (
      <div
        class:list={[
          layout === 'wide'
            ? 'grid grid-cols-1 gap-6 lg:grid-cols-2'
            : 'grid grid-cols-2 gap-px bg-border md:grid-cols-3 lg:grid-cols-4',
        ]}
      >
        {
          items.map((item) => {
            if (item.type === 'video') {
              return (
                <figure class="col-span-full overflow-hidden rounded-2xl border border-border/60 bg-surface">
                  <video
                    src={item.src}
                    controls
                    playsinline
                    muted={autoplayMuted}
                    autoplay={autoplayMuted}
                    loop={autoplayMuted}
                    preload={autoplayMuted ? 'metadata' : 'none'}
                    data-gallery-video
                    data-autoplay-muted={autoplayMuted ? 'true' : undefined}
                    class="aspect-video w-full bg-black object-contain"
                  />
                </figure>
              );
            }

            const index = imageIndex++;
            return layout === 'wide' ? (
              <figure
                class:list={[
                  'overflow-hidden rounded-2xl border border-border/60 bg-surface',
                  item.hero && 'lg:col-span-2',
                ]}
              >
                <button
                  type="button"
                  class="group block w-full focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
                  data-lightbox-item
                  data-group={groupId}
                  data-index={index}
                  data-src={item.src}
                  data-caption={item.caption}
                  data-type="image"
                  aria-label={item.caption ?? `Open image ${index + 1}`}
                >
                  <img
                    src={item.src}
                    alt={item.caption ?? `${altPrefix} ${index + 1}`}
                    loading={item.hero ? 'eager' : 'lazy'}
                    decoding="async"
                    draggable="false"
                    class:list={[
                      'pointer-events-none w-full object-contain transition duration-500 group-hover:opacity-90',
                      item.hero && 'max-h-[70vh]',
                    ]}
                  />
                </button>
              </figure>
            ) : (
              <button
                type="button"
                class:list={[
                  'group relative overflow-hidden bg-surface-elevated focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent',
                  item.hero ? 'col-span-2 aspect-[16/10] md:col-span-2' : 'aspect-square',
                ]}
                data-lightbox-item
                data-group={groupId}
                data-index={index}
                data-src={item.src}
                data-caption={item.caption}
                data-type="image"
                aria-label={item.caption ?? `Open image ${index + 1}`}
              >
                <img
                  src={item.src}
                  alt={item.caption ?? `${altPrefix} ${index + 1}`}
                  loading={item.hero ? 'eager' : 'lazy'}
                  decoding="async"
                  draggable="false"
                  class:list={[
                    'pointer-events-none h-full w-full transition duration-500 group-hover:scale-[1.03] group-hover:opacity-90',
                    item.hero ? 'object-contain' : 'object-cover',
                  ]}
                />
                <span class="pointer-events-none absolute inset-0 bg-black/0 transition group-hover:bg-black/20" />
              </button>
            );
          })
        }
      </div>
    )
  }

  {
    items.length === 0 && (
      <p class="rounded-xl border border-border/60 bg-surface px-4 py-6 text-sm text-muted">
        Media for this snapshot is being added to the project folder.
      </p>
    )
  }
</section>

<script>
  /** Load gallery videos only when near the viewport — avoids hammering DEADROP-scale pages. */
  function initGalleryVideos() {
    const videos = Array.from(
      document.querySelectorAll<HTMLVideoElement>('video[data-gallery-video]:not([data-autoplay-muted="true"])'),
    );
    if (videos.length === 0) return;

    if (!('IntersectionObserver' in window)) {
      videos.forEach((video) => {
        if (video.readyState === 0) video.load();
      });
      return;
    }

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          const video = entry.target as HTMLVideoElement;
          if (video.dataset.srcArmed === '1') return;
          video.dataset.srcArmed = '1';
          if (video.readyState === 0) video.load();
          observer.unobserve(video);
        });
      },
      { rootMargin: '200px 0px', threshold: 0.01 },
    );

    videos.forEach((video) => observer.observe(video));
  }

  initGalleryVideos();
  document.addEventListener('astro:page-load', initGalleryVideos);
</script>
