---
import '@fontsource-variable/inter/wght.css';
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import { getImage } from 'astro:assets';
import { resolveImage } from '../lib/responsive-images';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import SiteLightbox from '../components/SiteLightbox.astro';
import Analytics from '../components/Analytics.astro';
import { site, socialLinks } from '../data/site';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
}

const {
  title = site.name,
  description = site.description,
  ogImage = `${site.url}/images/OG-image.jpg`,
} = Astro.props;

const pageTitle = title === site.name ? `${site.name} | ${site.tagline}` : `${title} | ${site.name}`;

const pathname = Astro.url.pathname;
const canonicalPath =
  pathname === '/' || pathname.endsWith('/') || /\.[a-z0-9]+$/i.test(pathname)
    ? pathname
    : `${pathname}/`;
const canonicalUrl = new URL(canonicalPath, site.url).href;

// Share previews want ~1200×630 and reject multi-megabyte files, so crop local
// images to that size; external URLs pass through untouched.
const OG_WIDTH = 1200;
const OG_HEIGHT = 630;
const ogSource = ogImage.startsWith(site.url) ? resolveImage(ogImage.slice(site.url.length)) : undefined;
const ogResized = ogSource
  ? await getImage({ src: ogSource, width: OG_WIDTH, height: OG_HEIGHT, fit: 'cover', format: 'jpg', quality: 82 })
  : undefined;
const ogImageUrl = ogResized ? new URL(ogResized.src, site.url).href : ogImage;

const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: site.name,
  jobTitle: site.jobTitle,
  description: site.description,
  url: site.url,
  email: `mailto:${site.email}`,
  sameAs: socialLinks.map((link) => link.href),
  knowsAbout: [
    'Art direction',
    'Creative direction',
    'Game development',
    'Franchise visual strategy',
    'Live-service operations',
    'Halo',
    'Destiny',
    'Marathon',
  ],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#09090b" />
    <meta name="description" content={description} />
    <meta name="author" content={site.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageUrl} />
    {ogResized && <meta property="og:image:width" content={String(OG_WIDTH)} />}
    {ogResized && <meta property="og:image:height" content={String(OG_HEIGHT)} />}
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <title>{pageTitle}</title>
    <script type="application/ld+json" set:html={JSON.stringify(personSchema)} />
    <Analytics />
    <ClientRouter />
  </head>
  <body class="min-h-screen bg-bg text-fg">
    <div
      id="scroll-progress"
      class="fixed inset-x-0 top-0 z-[60] h-0.5 bg-accent"
      aria-hidden="true"
    >
    </div>
    <Header />
    <main>
      <slot />
    </main>
    <Footer />
    <SiteLightbox />
    <script src="../scripts/motion.ts"></script>
    <script src="../scripts/mutedAutoplay.ts"></script>
  </body>
</html>
