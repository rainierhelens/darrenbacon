---
import BaseLayout from '../layouts/BaseLayout.astro';
import Publications from '../components/Publications.astro';
import PressList from '../components/PressList.astro';
import { experience, shippedGames } from '../data/credits';
import {
  careerSpine,
  leadershipPhilosophy,
  leadershipCredentials,
  featuredRecommendation,
} from '../data/leadership';
import { RESUME_URL, RESUME_LABEL, resumeAvailable } from '../config/features';
---

<BaseLayout
  title="About"
  description="Darren Bacon — art director leading art teams and franchise visual strategy across Halo, Destiny, and Marathon."
>
  <section class="relative isolate overflow-hidden border-b border-border/60">
    <div class="pointer-events-none absolute inset-0 -z-10" aria-hidden="true">
      <div
        class="absolute inset-0 opacity-90"
        style="background-image: url('/images/sheet_of_post-its-2-1920.jpg'); background-repeat: repeat-x; background-size: auto 100%; background-position: left top;"
      >
      </div>
      <div class="absolute inset-0 bg-gradient-to-b from-bg/70 via-bg/85 to-bg"></div>
      <div class="absolute inset-0 bg-gradient-to-r from-bg/90 via-bg/55 to-bg/80"></div>
    </div>

    <div class="relative mx-auto max-w-7xl px-6 py-16 lg:px-8">
    <div class="grid gap-12 lg:grid-cols-[1.1fr_0.9fr] lg:items-stretch">
      <div data-reveal>
        <p class="text-sm tracking-[0.2em] uppercase text-accent">About</p>
        <h1 class="mt-2 text-4xl font-semibold tracking-tight">{`Darren Bacon`}</h1>
        <p class="mt-6 max-w-2xl leading-relaxed text-muted">
          Art director with two decades of experience stewarding some of the most beloved
          franchises in entertainment. I lead art teams and shape visual strategy, from the
          first vision frame to what millions of players see and interact with in a live
          product every day.
        </p>
        <p class="mt-4 max-w-2xl leading-relaxed text-muted">
          I've done senior concept work on Destiny at Bungie, served as Art Director on Halo
          Infinite at 343 Industries and DEADROP at Midnight Society, and now lead Commerce &amp;
          Events art on Marathon back at Bungie. Earlier, I designed and painted at Disney and
          Industrial Light &amp; Magic.
        </p>
        <p class="mt-4 max-w-2xl leading-relaxed text-muted">
          That span of work taught me how a franchise holds together visually, and how to evolve
          it without losing what audiences already trust.
        </p>
        <div class="mt-8 inline-flex flex-col items-stretch gap-5">
          <a
            href="https://www.linkedin.com/in/darrenbacon/"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Darren Bacon on LinkedIn"
            class="group relative block w-0 min-w-full overflow-hidden rounded-full border border-border/60 shadow-lg shadow-black/30 transition duration-500 hover:border-accent hover:shadow-accent/20"
          >
            <img
              src="/images/about/darren-bacon-about-720.gif?v=2"
              alt="Darren Bacon"
              width="1"
              height="1"
              class="aspect-square w-full object-cover transition duration-500 group-hover:scale-105"
              loading="lazy"
              decoding="async"
            />
          </a>
          <div class="flex flex-col gap-3">
            <a
              href="https://www.linkedin.com/in/darrenbacon/"
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex w-0 min-w-full items-center justify-center whitespace-nowrap rounded-full bg-accent px-5 py-2.5 text-sm font-medium text-bg transition hover:bg-accent-dim"
            >
              LinkedIn profile →
            </a>
            {
              resumeAvailable && (
                <a
                  href={RESUME_URL}
                  class="inline-flex items-center justify-center whitespace-nowrap rounded-full border border-border px-5 py-2.5 text-sm transition hover:border-accent hover:text-accent"
                >
                  {RESUME_LABEL}
                </a>
              )
            }
          </div>
        </div>
      </div>
      <div class="flex w-full max-lg:justify-center lg:h-full lg:min-h-0 lg:justify-end">
        <div
          class="spotlight sheen group relative w-full max-w-sm overflow-hidden rounded-2xl border border-border/60 max-lg:aspect-[9/16] lg:h-full lg:w-auto lg:max-w-full lg:aspect-[9/16]"
        >
          <video
            class="about-reel absolute inset-0 h-full w-full object-cover"
            src="/images/about/darren-bacon-about.mp4"
            muted
            loop
            playsinline
            controls
            preload="auto"
            autoplay
            aria-label="Darren Bacon — career and craft reel"
          >
          </video>
        </div>
      </div>
    </div>
    </div>
  </section>

  <section class="border-t border-border/60">
    <div class="mx-auto max-w-5xl px-6 py-16 lg:px-8">
      <figure class="spotlight relative overflow-hidden rounded-3xl border border-border/60 bg-surface p-8 sm:p-12" data-reveal>
        <span class="pointer-events-none absolute left-5 top-3 select-none font-serif text-[5.5rem] leading-none text-accent/35 sm:left-8 sm:top-5 sm:text-[6.5rem]">&ldquo;</span>
        <blockquote class="relative pt-10 text-xl font-medium leading-relaxed tracking-tight sm:pt-12 sm:text-2xl">
          {featuredRecommendation.quote}
        </blockquote>
        <figcaption class="mt-8 border-t border-border/60 pt-6">
          <p class="text-base font-semibold">{featuredRecommendation.name}</p>
          <p class="mt-1 text-sm text-muted">{featuredRecommendation.title}</p>
          <p class="mt-1 text-xs text-muted/80">{featuredRecommendation.context}</p>
          <a
            href={featuredRecommendation.letterHref}
            target="_blank"
            rel="noopener noreferrer"
            class="mt-4 inline-flex text-sm text-accent transition hover:text-accent-dim"
          >
            Read the full letter →
          </a>
        </figcaption>
      </figure>
    </div>
  </section>

  <section class="border-y border-border/60 bg-surface">
    <div class="mx-auto max-w-7xl px-6 py-16 lg:px-8">
      <p class="text-sm tracking-[0.2em] uppercase text-accent" data-reveal>How I lead</p>
      <h2 class="mt-2 max-w-2xl text-3xl font-semibold tracking-tight" data-reveal>
        Direction that holds up from pitch to live game
      </h2>
      <div class="mt-10 grid gap-6 md:grid-cols-3">
        {
          leadershipPhilosophy.map((item, index) => (
            <article
              class="spotlight rounded-2xl border border-border/60 bg-bg p-6 transition-colors duration-300 hover:border-accent/40"
              data-reveal
              data-reveal-stagger
              style={`--reveal-delay: ${index * 90}ms`}
            >
              <h3 class="text-lg font-medium">{item.title}</h3>
              <p class="mt-3 text-sm leading-relaxed text-muted">{item.body}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-7xl px-6 py-16 lg:px-8">
    <p class="text-sm tracking-[0.2em] uppercase text-accent" data-reveal>Leadership credentials</p>
    <h2 class="mt-2 max-w-2xl text-3xl font-semibold tracking-tight" data-reveal>
      Trained to lead people, not just pixels
    </h2>
    <p class="mt-4 max-w-2xl leading-relaxed text-muted" data-reveal>
      Alongside two decades of art vision, I've invested in the formal craft of leadership —
      Microsoft's manager programs and project-management certification.
    </p>
    <div class="mt-10 grid gap-6 md:grid-cols-3">
      {
        leadershipCredentials.map((cred, index) => (
          <article
            class="spotlight rounded-2xl border border-border/60 bg-surface p-6 transition-colors duration-300 hover:border-accent/40"
            data-reveal
            data-reveal-stagger
            style={`--reveal-delay: ${index * 90}ms`}
          >
            <div class="flex items-baseline justify-between gap-3">
              <p class="text-sm font-medium tracking-[0.15em] uppercase text-accent">{cred.issuer}</p>
              {cred.year && <span class="text-xs text-muted">{cred.year}</span>}
            </div>
            <h3 class="mt-3 text-lg font-medium leading-snug">{cred.title}</h3>
            {cred.note && <p class="mt-3 text-sm leading-relaxed text-muted">{cred.note}</p>}
          </article>
        ))
      }
    </div>
  </section>

  <section class="border-y border-border/60 bg-surface">
    <div class="mx-auto max-w-7xl px-6 py-16 lg:px-8" data-reveal>
      <h2 class="text-2xl font-semibold tracking-tight">Shipped games</h2>
      <div class="mt-8 overflow-x-auto">
        <table class="min-w-full text-left text-sm">
          <thead class="border-b border-border text-muted">
            <tr>
              <th class="py-3 pr-6 font-medium">Title</th>
              <th class="py-3 pr-6 font-medium">Platform</th>
              <th class="py-3 pr-6 font-medium">Year</th>
              <th class="py-3 pr-6 font-medium">Credit</th>
              <th class="py-3 font-medium">Company</th>
            </tr>
          </thead>
          <tbody>
            {
              shippedGames.map((game) => (
                <tr class="border-b border-border/60">
                  <td class="py-4 pr-6">
                    <a href={game.href} target="_blank" rel="noopener noreferrer" class="text-fg hover:text-accent">
                      {game.title}
                    </a>
                  </td>
                  <td class="py-4 pr-6 text-muted">{game.platform}</td>
                  <td class="py-4 pr-6 text-muted">{game.year}</td>
                  <td class="py-4 pr-6 text-muted">{game.credit}</td>
                  <td class="py-4 text-muted">{game.company}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <section class="border-t border-border/60 bg-bg">
    <div class="mx-auto max-w-7xl px-6 py-16 lg:px-8">
      <div data-reveal>
        <p class="text-sm tracking-[0.2em] uppercase text-accent">Career</p>
        <h2 class="mt-2 text-3xl font-semibold tracking-tight">The arc at a glance</h2>
        <p class="mt-3 max-w-2xl text-sm leading-relaxed text-muted">
          Five beats through the worlds I've helped shape — details in experience below.
        </p>
      </div>

      <ol
        class="career-spine mt-12 grid gap-8 sm:grid-cols-2 lg:grid-cols-5 lg:gap-0"
        data-reveal
      >
        {
          careerSpine.map((beat, index) => (
            <li class="career-spine__beat relative flex flex-col lg:px-3">
              <div class="flex items-center gap-3 lg:flex-col lg:items-start lg:gap-0">
                <span
                  class="career-spine__dot relative z-10 flex h-3 w-3 shrink-0 rounded-full bg-accent ring-4 ring-bg"
                  aria-hidden="true"
                />
                <span class="text-xs tracking-[0.14em] uppercase text-muted lg:mt-4">
                  {beat.period}
                </span>
              </div>
              <p class="mt-2 text-base font-medium tracking-tight lg:mt-3">
                {beat.studio}
                <span class="text-muted"> · {beat.focus}</span>
              </p>
              <p class="mt-1 text-sm leading-snug text-muted">{beat.note}</p>
              {index < careerSpine.length - 1 && (
                <span class="career-spine__connector" aria-hidden="true" />
              )}
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="mx-auto max-w-7xl px-6 py-16 lg:px-8">
    <h2 class="text-2xl font-semibold tracking-tight" data-reveal>Experience</h2>
    <div class="mt-8 space-y-6">
      {
        experience.map((job) => (
          <article
            class="spotlight rounded-2xl border border-border/60 bg-surface p-6 transition-colors duration-300 hover:border-accent/40"
            data-reveal
            data-reveal-stagger
          >
            <div class="flex flex-col gap-2 sm:flex-row sm:items-start sm:justify-between">
              <h3 class="text-lg font-medium">{job.role}</h3>
              <span class="text-sm text-muted">{job.period}</span>
            </div>
            <p class="mt-3 text-sm leading-relaxed text-muted">{job.summary}</p>
            {'shipped' in job && job.shipped && (
              <ul class="mt-4 flex flex-wrap gap-2">
                {job.shipped.map((title) => (
                  <li class="rounded-full border border-border px-3 py-1 text-xs text-muted">{title}</li>
                ))}
              </ul>
            )}
          </article>
        ))
      }
    </div>
  </section>

  <style>
    .career-spine__connector {
      display: none;
    }

    @media (min-width: 1024px) {
      .career-spine__beat:not(:last-child) .career-spine__connector {
        display: block;
        position: absolute;
        top: 0.35rem;
        left: calc(0.375rem + 0.75rem);
        right: -0.75rem;
        height: 1px;
        background: color-mix(in srgb, var(--color-border) 90%, transparent);
      }
    }
  </style>

  <Publications />

  <PressList />
</BaseLayout>
