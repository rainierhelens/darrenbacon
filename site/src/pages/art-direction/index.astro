---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArtDirectionGalleryTile from '../../components/ArtDirectionGalleryTile.astro';
import {
  getDeadropArtDirectionImages,
  getHaloArtDirectionImages,
} from '../../lib/art-direction-gallery';
import { MARATHON_LOGO, marathonCaseStudyVisible } from '../../config/features';
---

<BaseLayout
  title="Art Direction"
  description="Art direction samples by Darren Bacon — style guides, world building, and shipped AAA production work."
>
  <section class="relative isolate overflow-hidden">
    <div class="pointer-events-none absolute inset-0 -z-10" aria-hidden="true">
      <video
        class="art-direction-bg-video absolute inset-0 h-full w-full object-cover opacity-30"
        src="/images/art-direction/motorcycle-edit-sequence-01.mp4"
        muted
        loop
        playsinline
        preload="auto"
        autoplay
      >
      </video>
      <div class="absolute inset-0 bg-gradient-to-b from-bg/40 via-bg/55 to-bg/70"></div>
      <div class="absolute inset-0 bg-gradient-to-r from-bg/50 via-bg/25 to-bg/45"></div>
    </div>

    <div class="relative mx-auto max-w-7xl px-6 pb-8 pt-16 lg:px-8 lg:pt-20" data-reveal>
      <p class="text-sm tracking-[0.2em] uppercase text-accent">Work</p>
      <h1 class="mt-2 text-4xl font-semibold tracking-tight">Art direction</h1>
      <p class="mt-4 max-w-2xl text-muted">
        Case studies from Halo Infinite, DEADROP, and Marathon — art direction across AAA production
        and open development.
      </p>
    </div>

    <div class="relative mx-auto grid max-w-7xl gap-6 px-6 pb-24 lg:grid-cols-2 lg:px-8">
      <ArtDirectionGalleryTile
        href="/art-direction/halo"
        studio="343 Industries"
        title="Halo Infinite"
        description="Art Director on multiplayer and live content — visual targets, environment passes, and production polish across shipped seasons."
        images={getHaloArtDirectionImages()}
        staggerIndex={0}
      />
      <ArtDirectionGalleryTile
        href="/art-direction/deadrop"
        studio="Midnight Society"
        title="DEADROP"
        description="Art Director across Snapshots I–VII — live reveals in LA, Dallas, and Vegas, Midnight Ride, and the 2024 showcase trailer built from in-engine captures."
        images={getDeadropArtDirectionImages()}
        staggerIndex={1}
      />
      {
        marathonCaseStudyVisible ? (
          <ArtDirectionGalleryTile
            href="/art-direction/marathon"
            studio="Bungie"
            title="Marathon"
            description="Commerce & Events Art Lead — seasonal cosmetics, Battle Pass earnables, store presentation, and live-service event art across two launch seasons."
            images={[MARATHON_LOGO]}
            mediaFit="contain"
            staggerIndex={2}
          />
        ) : (
          <article class="overflow-hidden rounded-2xl border border-border/60 bg-surface lg:col-span-2">
            <div class="grid lg:grid-cols-2">
              <div class="flex aspect-video items-center justify-center overflow-hidden bg-bg lg:aspect-auto">
                <img
                  src={MARATHON_LOGO}
                  alt="Marathon art direction preview"
                  loading="lazy"
                  class="max-h-full max-w-[70%] object-contain p-8 lg:p-12"
                />
              </div>
              <div class="flex flex-col justify-center p-6 lg:p-10">
                <p class="text-xs tracking-[0.2em] uppercase text-accent">Bungie</p>
                <h2 class="mt-2 text-2xl font-medium">Marathon</h2>
                <p class="mt-3 text-sm leading-relaxed text-muted">
                  Commerce &amp; Events Art Lead at Bungie — shaping visual strategy for cosmetics,
                  earnables, live-service events, and commerce in Marathon.
                </p>
                <p class="mt-6 text-sm text-muted">Full case study coming soon.</p>
              </div>
            </div>
          </article>
        )
      }
    </div>
  </section>
</BaseLayout>
