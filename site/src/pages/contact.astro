---
import BaseLayout from '../layouts/BaseLayout.astro';
import ContactForm from '../components/ContactForm.astro';
import { site, socialLinks } from '../data/site';
import { RESUME_URL, RESUME_LABEL, resumeAvailable } from '../config/features';

const mailtoHref = `mailto:${site.email}`;
const linkedIn = socialLinks.find((link) => link.label === 'LinkedIn');
---

<BaseLayout
  title="Contact"
  description="Contact Darren Bacon about art and creative leadership roles and studio collaborations."
>
  <section class="relative isolate overflow-hidden">
    <div class="pointer-events-none absolute inset-0 -z-10" aria-hidden="true">
      <video
        class="contact-bg-video absolute inset-0 h-full w-full object-cover"
        src="/images/contact/bladerunner-sequence-06.mp4"
        muted
        loop
        playsinline
        preload="auto"
        autoplay
      >
      </video>
      <div class="absolute inset-0 bg-gradient-to-b from-bg/40 via-bg/55 to-bg/70"></div>
      <div class="absolute inset-0 bg-gradient-to-r from-bg/50 via-bg/25 to-bg/45"></div>
    </div>

    <div class="relative mx-auto max-w-xl px-6 pb-20 pt-12 sm:pt-16 lg:pb-28 lg:pt-20">
      <p class="text-sm tracking-[0.2em] uppercase text-accent">Contact</p>
      <h1 class="mt-2 text-4xl font-semibold tracking-tight">Let's talk</h1>
      <p class="mt-3 text-muted">
        Open to art and creative leadership roles, franchise stewardship, studio conversations,
        collaborations, and press. I reply within two business days.
      </p>
      <div class="mt-4 flex flex-wrap items-center gap-x-8 gap-y-3">
        <a href={mailtoHref} class="text-accent transition hover:text-fg">{site.email}</a>
        {
          linkedIn && (
            <a href={linkedIn.href} target="_blank" rel="noopener noreferrer" class="text-sm text-muted transition hover:text-accent">
              LinkedIn →
            </a>
          )
        }
        {
          resumeAvailable && (
            <a href={RESUME_URL} class="text-sm text-muted transition hover:text-accent">
              {RESUME_LABEL} →
            </a>
          )
        }
      </div>
      <ContactForm />
    </div>
  </section>
</BaseLayout>
