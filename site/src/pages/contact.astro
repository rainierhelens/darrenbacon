---
import BaseLayout from '../layouts/BaseLayout.astro';
import ContactForm from '../components/ContactForm.astro';
import { site, socialLinks } from '../data/site';
import { RESUME_URL, RESUME_LABEL, resumeAvailable } from '../config/features';

const linkedIn = socialLinks.find((link) => link.label === 'LinkedIn');
---

<BaseLayout title="Contact" description="Contact Darren Bacon about art and creative leadership roles and studio collaborations.">
  <section class="mx-auto max-w-7xl px-6 py-16 lg:px-8">
    <p class="text-sm tracking-[0.2em] uppercase text-accent">Get in touch</p>
    <h1 class="mt-2 text-4xl font-semibold tracking-tight">Let's talk</h1>
    <p class="mt-4 max-w-2xl text-muted">
      Open to art and creative leadership roles, franchise stewardship, and studio conversations —
      as well as collaborations and press. Send a message below or reach out directly.
    </p>
    <div class="mt-6 flex flex-wrap items-center gap-x-8 gap-y-3">
      <a href={`mailto:${site.email}`} class="text-accent transition hover:text-fg">{site.email}</a>
      {
        linkedIn && (
          <a href={linkedIn.href} target="_blank" rel="noopener noreferrer" class="text-sm text-muted transition hover:text-accent">
            LinkedIn →
          </a>
        )
      }
      {
        resumeAvailable && (
          <a href={RESUME_URL} class="text-sm text-muted transition hover:text-accent">
            {RESUME_LABEL} →
          </a>
        )
      }
    </div>
  </section>

  <ContactForm />
</BaseLayout>
