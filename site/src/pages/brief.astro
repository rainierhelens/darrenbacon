---
import { site, socialLinks } from '../data/site';
import {
  impactStats,
  signatureCredentials,
  leadershipHighlights,
  leadershipCredentials,
  featuredRecommendation,
} from '../data/leadership';
import { shippedGames } from '../data/credits';
import { press } from '../data/press';
import { publications } from '../data/publications';

const linkedIn = socialLinks.find((link) => link.label === 'LinkedIn');
const gdcTalks = press.filter((item) => item.outlet.includes('GDC')).length;
const bookCount = publications.length;
const pressOutlets = [...new Set(press.filter((item) => !item.outlet.includes('GDC')).map((item) => item.outlet))];
// Curated for the brief — leadership-forward titles, one per franchise.
// Pulls credit + year from credits.ts as the source of truth.
const briefTitles = [
  'Marathon',
  'Halo Infinite - Multiplayer',
  'Halo 5: Forge',
  'Halo 5: Guardians',
  'Destiny',
];
const topShipped = briefTitles.flatMap((title) => {
  const game = shippedGames.find((g) => g.title === title);
  return game ? [{ title: game.title, credit: game.credit, year: game.year }] : [];
});
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{site.name} — Leadership Brief</title>
    <meta
      name="description"
      content="One-page leadership brief for Darren Bacon — art & creative director for franchise and studio leadership."
    />
  </head>
  <body>
    <div class="toolbar">
      <a class="back" href="/">← Back to site</a>
      <button type="button" id="print-btn">Print / Save as PDF</button>
    </div>

    <main class="page">
      <header class="head">
        <div>
          <h1>{site.name}</h1>
          <p class="role">{site.tagline}</p>
        </div>
        <ul class="contact">
          <li><a href={`mailto:${site.email}`}>{site.email}</a></li>
          {linkedIn && <li><a href={linkedIn.href}>linkedin.com/in/darrenbacon</a></li>}
          <li><a href={site.url}>darrenbacon.com</a></li>
        </ul>
      </header>

      <p class="summary">
        Art and creative director with two decades stewarding beloved worlds in games and film — from
        senior concept work on Destiny to Art Director on Halo Infinite, Studio Art Director on
        DEADROP, and today Commerce &amp; Events Art Lead on Marathon. I build and lead art teams, set
        franchise visual strategy, and run live-service and commerce at scale — evolving universes without
        breaking the promise fans fell in love with.
      </p>

      <ul class="roles">
        {signatureCredentials.map((cred) => <li>{cred}</li>)}
      </ul>

      <section class="stats">
        {
          impactStats.map((stat) => (
            <div>
              <span class="value">{stat.value}</span>
              <span class="label">{stat.label}</span>
            </div>
          ))
        }
      </section>

      <section class="cols">
        <div class="col">
          <h2>What I bring</h2>
          {
            leadershipHighlights.map((item) => (
              <div class="block">
                <h3>{item.title}</h3>
                <p>{item.body}</p>
              </div>
            ))
          }
        </div>

        <div class="col">
          <h2>Selected shipped titles</h2>
          <ul class="shipped">
            {
              topShipped.map((game) => (
                <li>
                  <span class="title">{game.title}</span>
                  <span class="meta">{game.credit} · {game.year}</span>
                </li>
              ))
            }
          </ul>

          <h2 class="mt">Leadership credentials</h2>
          <ul class="creds">
            {
              leadershipCredentials.map((cred) => (
                <li>
                  <span class="title">{cred.title}</span>
                  <span class="meta">{cred.issuer}{cred.year ? ` · ${cred.year}` : ''}</span>
                </li>
              ))
            }
          </ul>

          <h2 class="mt">Recognition</h2>
          <p class="recognition">
            {gdcTalks}× GDC speaker (2015–2026) · {bookCount} published art books (Star Wars, Halo,
            Destiny &amp; more) · featured in {pressOutlets.join(', ')}.
          </p>
        </div>
      </section>

      <blockquote class="quote">
        &ldquo;{featuredRecommendation.shortQuote}&rdquo;
        <cite>— {featuredRecommendation.name}, {featuredRecommendation.title}</cite>
      </blockquote>
    </main>

    <style is:global>
      :root {
        --ink: #1a1a1f;
        --muted: #55555f;
        --line: #d8d8de;
        --accent: #1f7a5a;
        --bg: #ffffff;
      }

      * {
        box-sizing: border-box;
      }

      html,
      body {
        margin: 0;
        padding: 0;
      }

      body {
        background: #ececed;
        color: var(--ink);
        font-family: 'Segoe UI', -apple-system, BlinkMacSystemFont, Helvetica, Arial, sans-serif;
        line-height: 1.5;
        -webkit-font-smoothing: antialiased;
      }

      .toolbar {
        max-width: 820px;
        margin: 0 auto;
        padding: 16px 8px;
        display: flex;
        justify-content: space-between;
        align-items: center;
      }

      .toolbar .back {
        color: var(--muted);
        text-decoration: none;
        font-size: 14px;
      }

      .toolbar .back:hover {
        color: var(--ink);
      }

      #print-btn {
        border: 1px solid var(--accent);
        background: var(--accent);
        color: #fff;
        border-radius: 999px;
        padding: 8px 18px;
        font-size: 14px;
        cursor: pointer;
      }

      #print-btn:hover {
        opacity: 0.9;
      }

      .page {
        max-width: 820px;
        margin: 0 auto 48px;
        background: var(--bg);
        padding: 44px 52px;
        box-shadow: 0 12px 40px rgba(0, 0, 0, 0.12);
      }

      .head {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        gap: 24px;
        border-bottom: 2px solid var(--ink);
        padding-bottom: 16px;
      }

      h1 {
        margin: 0;
        font-size: 30px;
        letter-spacing: -0.01em;
      }

      .role {
        margin: 4px 0 0;
        color: var(--accent);
        font-weight: 600;
        letter-spacing: 0.14em;
        text-transform: uppercase;
        font-size: 13px;
      }

      .contact {
        list-style: none;
        margin: 0;
        padding: 0;
        text-align: right;
        font-size: 13px;
      }

      .contact a {
        color: var(--muted);
        text-decoration: none;
      }

      .summary {
        margin: 18px 0 0;
        font-size: 15px;
        color: #33333a;
      }

      .roles {
        list-style: none;
        margin: 18px 0 0;
        padding: 0;
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
      }

      .roles li {
        border: 1px solid var(--line);
        border-radius: 999px;
        padding: 4px 12px;
        font-size: 12.5px;
        font-weight: 600;
        color: #33333a;
      }

      .stats {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 12px;
        margin: 24px 0;
        padding: 18px 0;
        border-top: 1px solid var(--line);
        border-bottom: 1px solid var(--line);
      }

      .stats .value {
        display: block;
        font-size: 26px;
        font-weight: 700;
        color: var(--accent);
        letter-spacing: -0.01em;
      }

      .stats .label {
        display: block;
        font-size: 11.5px;
        color: var(--muted);
        margin-top: 2px;
      }

      .cols {
        display: grid;
        grid-template-columns: 1.15fr 0.85fr;
        gap: 36px;
      }

      h2 {
        font-size: 12px;
        letter-spacing: 0.16em;
        text-transform: uppercase;
        color: var(--accent);
        margin: 0 0 12px;
        border-bottom: 1px solid var(--line);
        padding-bottom: 6px;
      }

      h2.mt {
        margin-top: 22px;
      }

      .block {
        margin-bottom: 14px;
      }

      .block h3 {
        margin: 0;
        font-size: 15px;
      }

      .block p {
        margin: 3px 0 0;
        font-size: 13px;
        color: #44444c;
      }

      .shipped,
      .creds {
        list-style: none;
        margin: 0;
        padding: 0;
      }

      .shipped li,
      .creds li {
        margin-bottom: 8px;
      }

      .shipped .title,
      .creds .title {
        display: block;
        font-size: 14px;
        font-weight: 600;
      }

      .shipped .meta,
      .creds .meta {
        display: block;
        font-size: 12px;
        color: var(--muted);
      }

      .recognition {
        margin: 0;
        font-size: 13px;
        color: #44444c;
      }

      .quote {
        margin: 28px 0 0;
        padding: 18px 22px;
        border-left: 3px solid var(--accent);
        background: #f5f7f6;
        font-size: 15px;
        font-style: italic;
        color: #2a2a30;
      }

      .quote cite {
        display: block;
        margin-top: 10px;
        font-style: normal;
        font-size: 12.5px;
        color: var(--muted);
      }

      @media (max-width: 700px) {
        .head,
        .cols {
          grid-template-columns: 1fr;
          flex-direction: column;
        }
        .contact {
          text-align: left;
        }
        .stats {
          grid-template-columns: repeat(2, 1fr);
        }
        .page {
          padding: 28px 22px;
        }
      }

      @media print {
        body {
          background: #fff;
        }
        .toolbar {
          display: none;
        }
        .page {
          box-shadow: none;
          margin: 0 auto;
          max-width: none;
          padding: 0;
        }
        .quote {
          background: transparent;
        }
        a {
          color: var(--ink) !important;
        }
      }

      @page {
        margin: 14mm;
      }
    </style>

    <script>
      document.getElementById('print-btn')?.addEventListener('click', () => window.print());
    </script>
  </body>
</html>
