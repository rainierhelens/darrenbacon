---
import { site, socialLinks } from '../data/site';
import {
  impactStats,
  signatureCredentials,
  leadershipCredentials,
  featuredRecommendation,
} from '../data/leadership';
import { shippedGames } from '../data/credits';
import { press } from '../data/press';
import { publications } from '../data/publications';
import { RESUME_PDF_URL, RESUME_PDF_FILENAME } from '../config/features';

const linkedIn = socialLinks.find((link) => link.label === 'LinkedIn');
const gdcTalks = press.filter((item) => item.outlet.includes('GDC')).length;
const bookCount = publications.length;
const pressOutlets = [...new Set(press.filter((item) => !item.outlet.includes('GDC')).map((item) => item.outlet))];

const briefTitles = [
  'Marathon',
  'Halo Infinite - Multiplayer',
  'Halo 5: Guardians',
  'Destiny',
];
const topShipped = briefTitles.flatMap((title) => {
  const game = shippedGames.find((g) => g.title === title);
  return game ? [{ title: game.title, credit: game.credit, year: game.year }] : [];
});

const briefHighlights = [
  {
    title: 'Built and ran a studio art team',
    body: 'Stood up and led a full game studio art team from scratch plus co-developers at Midnight Society, driving DEADROP from concept through seven pre-alphas and three major showcase events.',
  },
  {
    title: 'Stewarded $5B franchises',
    body: 'Authored the Halo Infinite Art Index and directed art across a ~400-artist program — evolving Halo and Destiny through vision, style guides, and consumer products.',
  },
  {
    title: 'Drives live-service & commerce',
    body: 'Leads commerce, earnables, and live-events art on Marathon — seasonal cadence, monetization, and the business of a live game, not just its visuals.',
  },
];

const briefCredentials = leadershipCredentials.map((cred) => ({
  title: cred.title
    .replace('Managing at Microsoft II: Deliver Results Through Teams', 'Managing at Microsoft II')
    .replace('CompTIA Project+ (Project Management)', 'CompTIA Project+'),
  meta: `${cred.issuer}${cred.year ? ` · ${cred.year}` : ''}`,
}));

const briefStats = impactStats.map((stat) => ({
  value: stat.value,
  label: stat.label
    .replace('Best Game — Destiny (2015)', 'Best Game — Destiny')
    .replace('AAA franchises shipped — Halo, Destiny, Marathon', 'AAA franchises — Halo, Destiny, Marathon')
    .replace('Players reached across shipped titles', 'Players reached')
    .replace('Studios — Bungie, 343, Midnight Society, Disney, ILM, EA', 'Studios across games & film'),
}));
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{site.name} — Leadership Brief</title>
    <meta
      name="description"
      content="One-page leadership brief for Darren Bacon — art director for franchise and studio leadership."
    />
  </head>
  <body>
    <div class="toolbar">
      <a class="back" href="/">← Back to site</a>
      <div class="toolbar-actions">
        <a class="download" href={RESUME_PDF_URL} download={RESUME_PDF_FILENAME}>
          Download PDF
        </a>
        <button type="button" id="print-btn">Print</button>
      </div>
    </div>

    <main class="page">
      <header class="head">
        <div>
          <h1>{site.name}</h1>
          <p class="role">{site.tagline}</p>
        </div>
        <ul class="contact">
          <li><a href={`mailto:${site.email}`}>{site.email}</a></li>
          {linkedIn && <li><a href={linkedIn.href}>linkedin.com/in/darrenbacon</a></li>}
          <li><a href={site.url}>darrenbacon.com</a></li>
        </ul>
      </header>

      <p class="summary">
        Art director with two decades stewarding beloved worlds in games and film —
        Destiny at Bungie, Art Director on Halo Infinite, Studio Art Director at Midnight Society,
        and today Commerce &amp; Events Art Lead on Marathon. I build and lead art teams, set franchise
        visual strategy, and run live-service and commerce at scale.
      </p>

      <ul class="roles">
        {signatureCredentials.map((cred) => <li>{cred}</li>)}
      </ul>

      <section class="stats">
        {
          briefStats.map((stat) => (
            <div class="stat">
              <span class="value">{stat.value}</span>
              <span class="label">{stat.label}</span>
            </div>
          ))
        }
      </section>

      <section class="cols">
        <div class="col">
          <h2>What I bring</h2>
          {
            briefHighlights.map((item) => (
              <div class="block">
                <h3>{item.title}</h3>
                <p>{item.body}</p>
              </div>
            ))
          }
        </div>

        <div class="col">
          <h2>Selected shipped titles</h2>
          <ul class="shipped">
            {
              topShipped.map((game) => (
                <li>
                  <span class="title">{game.title}</span>
                  <span class="meta">{game.credit} · {game.year}</span>
                </li>
              ))
            }
          </ul>

          <h2 class="mt">Leadership credentials</h2>
          <ul class="creds">
            {
              briefCredentials.map((cred) => (
                <li>
                  <span class="title">{cred.title}</span>
                  <span class="meta">{cred.meta}</span>
                </li>
              ))
            }
          </ul>

          <h2 class="mt">Recognition</h2>
          <p class="recognition">
            {gdcTalks}× GDC speaker (2015–2026) · {bookCount} published art books · featured in{' '}
            {pressOutlets.join(', ')}.
          </p>
        </div>
      </section>

      <blockquote class="quote">
        &ldquo;{featuredRecommendation.shortQuote}&rdquo;
        <cite>— {featuredRecommendation.name}, Academy Award-winning Production Designer; VP &amp; ECD, Lucasfilm</cite>
      </blockquote>
    </main>

    <style is:global>
      :root {
        --ink: #1a1a1f;
        --muted: #55555f;
        --line: #d8d8de;
        --accent: #1f7a5a;
        --bg: #ffffff;
      }

      * {
        box-sizing: border-box;
      }

      html,
      body {
        margin: 0;
        padding: 0;
      }

      body {
        background: #ececed;
        color: var(--ink);
        font-family: 'Segoe UI', -apple-system, BlinkMacSystemFont, Helvetica, Arial, sans-serif;
        line-height: 1.4;
        -webkit-font-smoothing: antialiased;
      }

      .toolbar {
        max-width: 8.5in;
        margin: 0 auto;
        padding: 16px 8px;
        display: flex;
        justify-content: space-between;
        align-items: center;
      }

      .toolbar .back {
        color: var(--muted);
        text-decoration: none;
        font-size: 14px;
      }

      .toolbar .back:hover {
        color: var(--ink);
      }

      .toolbar-actions {
        display: flex;
        align-items: center;
        gap: 10px;
      }

      .toolbar .download,
      #print-btn {
        border: 1px solid var(--accent);
        border-radius: 999px;
        padding: 8px 18px;
        font-size: 14px;
        text-decoration: none;
        cursor: pointer;
      }

      .toolbar .download {
        background: #fff;
        color: var(--accent);
      }

      #print-btn {
        background: var(--accent);
        color: #fff;
      }

      .toolbar .download:hover,
      #print-btn:hover {
        opacity: 0.9;
      }

      /*
        Fixed letter canvas. Screen and print share the same proportions so what
        you see is what prints — one page, with comfortable hierarchy.
      */
      .page {
        width: 8.5in;
        height: 11in;
        max-width: 100%;
        margin: 0 auto 48px;
        background: var(--bg);
        padding: 0.5in 0.58in;
        box-shadow: 0 12px 40px rgba(0, 0, 0, 0.12);
        display: flex;
        flex-direction: column;
        overflow: hidden;
      }

      .head {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        gap: 20px;
        border-bottom: 2px solid var(--ink);
        padding-bottom: 12px;
        flex-shrink: 0;
      }

      h1 {
        margin: 0;
        font-size: 28px;
        letter-spacing: -0.015em;
        line-height: 1.1;
      }

      .role {
        margin: 4px 0 0;
        color: var(--accent);
        font-weight: 600;
        letter-spacing: 0.14em;
        text-transform: uppercase;
        font-size: 12px;
      }

      .contact {
        list-style: none;
        margin: 0;
        padding: 0;
        text-align: right;
        font-size: 12.5px;
        line-height: 1.5;
      }

      .contact a {
        color: var(--muted);
        text-decoration: none;
      }

      .contact a:hover {
        color: var(--ink);
      }

      .summary {
        margin: 14px 0 0;
        font-size: 13.5px;
        color: #33333a;
        flex-shrink: 0;
      }

      .roles {
        list-style: none;
        margin: 12px 0 0;
        padding: 0;
        display: flex;
        flex-wrap: wrap;
        gap: 6px;
        flex-shrink: 0;
      }

      .roles li {
        border: 1px solid var(--line);
        border-radius: 999px;
        padding: 4px 11px;
        font-size: 11.5px;
        font-weight: 600;
        color: #33333a;
      }

      .stats {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 12px;
        margin: 14px 0;
        padding: 12px 0;
        border-top: 1px solid var(--line);
        border-bottom: 1px solid var(--line);
        flex-shrink: 0;
      }

      .stats .value {
        display: block;
        font-size: 22px;
        font-weight: 700;
        color: var(--accent);
        letter-spacing: -0.02em;
        line-height: 1.1;
      }

      .stats .label {
        display: block;
        font-size: 11px;
        color: var(--muted);
        margin-top: 3px;
        line-height: 1.3;
      }

      .cols {
        display: grid;
        grid-template-columns: 1.2fr 0.8fr;
        gap: 26px;
        flex: 1 1 auto;
        min-height: 0;
      }

      h2 {
        font-size: 11px;
        letter-spacing: 0.16em;
        text-transform: uppercase;
        color: var(--accent);
        margin: 0 0 10px;
        border-bottom: 1px solid var(--line);
        padding-bottom: 5px;
      }

      h2.mt {
        margin-top: 16px;
      }

      .block {
        margin-bottom: 12px;
      }

      .block:last-child {
        margin-bottom: 0;
      }

      .block h3 {
        margin: 0;
        font-size: 14px;
        line-height: 1.25;
      }

      .block p {
        margin: 4px 0 0;
        font-size: 12.5px;
        color: #44444c;
        line-height: 1.4;
      }

      .shipped,
      .creds {
        list-style: none;
        margin: 0;
        padding: 0;
      }

      .shipped li,
      .creds li {
        margin-bottom: 8px;
      }

      .shipped li:last-child,
      .creds li:last-child {
        margin-bottom: 0;
      }

      .shipped .title,
      .creds .title {
        display: block;
        font-size: 13px;
        font-weight: 600;
        line-height: 1.25;
      }

      .shipped .meta,
      .creds .meta {
        display: block;
        font-size: 11.5px;
        color: var(--muted);
        margin-top: 1px;
      }

      .recognition {
        margin: 0;
        font-size: 12.5px;
        color: #44444c;
        line-height: 1.4;
      }

      .quote {
        margin: 14px 0 0;
        padding: 12px 14px;
        border-left: 3px solid var(--accent);
        background: #f5f7f6;
        font-size: 13px;
        font-style: italic;
        color: #2a2a30;
        line-height: 1.4;
        flex-shrink: 0;
      }

      .quote cite {
        display: block;
        margin-top: 6px;
        font-style: normal;
        font-size: 11.5px;
        color: var(--muted);
      }

      @media (max-width: 700px) {
        .page {
          width: auto;
          height: auto;
          overflow: visible;
          padding: 28px 22px;
        }
        .head,
        .cols {
          grid-template-columns: 1fr;
        }
        .contact {
          text-align: left;
        }
        .stats {
          grid-template-columns: repeat(2, 1fr);
        }
      }

      @media print {
        html,
        body {
          background: #fff;
          width: 8.5in;
          height: 11in;
        }
        .toolbar {
          display: none !important;
        }
        .page {
          width: 8.5in;
          height: 11in;
          margin: 0;
          padding: 0.5in 0.58in;
          box-shadow: none;
          overflow: hidden;
          page-break-after: avoid;
          break-after: avoid;
          page-break-inside: avoid;
          break-inside: avoid;
        }
        .quote {
          background: transparent;
        }
        a {
          color: var(--ink) !important;
          text-decoration: none;
        }
      }

      @page {
        size: letter;
        margin: 0;
      }
    </style>

    <script>
      document.getElementById('print-btn')?.addEventListener('click', () => window.print());
    </script>
  </body>
</html>
