---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import StatStrip from '../components/StatStrip.astro';
import ConceptGalleryTile from '../components/ConceptGalleryTile.astro';
import SectionBackdrop from '../components/SectionBackdrop.astro';
import { getDeadropArtDirectionImages, getHaloArtDirectionImages } from '../lib/art-direction-gallery';
import { conceptGalleries, site } from '../data/site';
import {
  credentialStudios,
  signatureCredentials,
  leadershipHighlights,
  featuredRecommendation,
} from '../data/leadership';
import { RESUME_URL, RESUME_LABEL } from '../config/features';
import { press } from '../data/press';
import { publications } from '../data/publications';

const artDirectionBackdrop = [...getHaloArtDirectionImages(), ...getDeadropArtDirectionImages()];
const ctaBackdrop = getDeadropArtDirectionImages();

const gdcTalks = press.filter((item) => item.outlet.includes('GDC')).length;
const bookCount = publications.length;
const pressOutlets = [...new Set(press.filter((item) => !item.outlet.includes('GDC')).map((item) => item.outlet))];
---

<BaseLayout
  title={site.name}
  description="Art and creative director Darren Bacon — leading art teams and franchise visual strategy across Halo, Destiny, and Marathon."
>
  <Hero />

  <section class="border-b border-border/60 bg-bg">
    <div class="mx-auto max-w-7xl px-6 py-6 lg:px-8" data-reveal>
      <ul class="flex flex-wrap items-center justify-center gap-x-3 gap-y-2 text-sm">
        {
          signatureCredentials.map((cred, index) => (
            <>
              {index > 0 && (
                <li class="text-border/80" aria-hidden="true">
                  /
                </li>
              )}
              <li class="font-medium tracking-wide text-fg/80">{cred}</li>
            </>
          ))
        }
      </ul>
      <p class="mt-4 text-center">
        <a href={RESUME_URL} class="text-sm text-accent transition hover:text-fg">
          Read the {RESUME_LABEL.toLowerCase()} →
        </a>
      </p>
    </div>
  </section>

  <StatStrip />

  <section class="border-b border-border/60 bg-bg">
    <div class="mx-auto max-w-7xl px-6 py-8 lg:px-8" data-reveal>
      <p class="mb-5 text-center text-xs tracking-[0.25em] uppercase text-muted">
        Two decades across the industry's most demanding studios
      </p>
      <ul class="flex flex-wrap items-center justify-center gap-x-8 gap-y-3">
        {
          credentialStudios.map((studio) => (
            <li class="text-sm font-medium tracking-wide text-fg/70">{studio.name}</li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="border-b border-border/60 bg-bg">
    <div class="mx-auto max-w-7xl px-6 py-20 lg:px-8">
      <div class="max-w-2xl" data-reveal>
        <p class="text-sm tracking-[0.2em] uppercase text-accent">Leadership at a glance</p>
        <h2 class="mt-2 text-3xl font-semibold tracking-tight">Built to run a studio — not just an art wall</h2>
        <p class="mt-4 leading-relaxed text-muted">
          Two decades of art direction backed by the operator work that actually ships games:
          standing up teams, stewarding franchises, and running live-service and commerce at scale.
        </p>
        <a href="/perspective" class="mt-6 inline-flex text-sm text-accent transition hover:text-fg">
          Read my point of view on stewarding beloved worlds →
        </a>
      </div>
      <div class="mt-12 grid gap-6 md:grid-cols-3">
        {
          leadershipHighlights.map((item, index) => (
            <article
              class="spotlight rounded-2xl border border-border/60 bg-surface p-6 transition-colors duration-300 hover:border-accent/40"
              data-reveal
              data-reveal-stagger
              style={`--reveal-delay: ${index * 90}ms`}
            >
              <h3 class="text-lg font-medium">{item.title}</h3>
              <p class="mt-3 text-sm leading-relaxed text-muted">{item.body}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="border-b border-border/60 bg-surface">
    <div class="mx-auto max-w-4xl px-6 py-16 text-center lg:px-8" data-reveal>
      <blockquote class="text-xl font-medium leading-relaxed tracking-tight sm:text-2xl">
        &ldquo;{featuredRecommendation.shortQuote}&rdquo;
      </blockquote>
      <figcaption class="mt-6 text-sm text-muted">
        <span class="font-semibold text-fg">{featuredRecommendation.name}</span> — {featuredRecommendation.title}
        <a href="/about" class="mt-3 block text-accent transition hover:text-fg">Read more →</a>
      </figcaption>
    </div>
  </section>

  <section class="relative isolate overflow-hidden border-b border-border/60 bg-surface">
    <SectionBackdrop images={artDirectionBackdrop} opacity={0.16} />
    <div class="relative z-10 mx-auto grid max-w-7xl gap-10 px-6 py-20 lg:grid-cols-2 lg:px-8">
      <div data-reveal>
        <p class="text-sm tracking-[0.2em] uppercase text-accent">Art direction & leadership</p>
        <h2 class="mt-2 text-3xl font-semibold tracking-tight">Leading visual development at scale</h2>
        <p class="mt-4 max-w-xl leading-relaxed text-muted">
          Setting franchise direction and aligning art teams from vision through shipped, live content —
          across Halo Infinite, DEADROP, and Marathon.
        </p>
        <a href="/art-direction" class="mt-8 inline-flex text-sm text-accent transition hover:text-fg">
          Explore art direction →
        </a>
      </div>
      <a
        href="/art-direction"
        data-reveal
        class="spotlight sheen group block overflow-hidden rounded-2xl border border-border/60 transition duration-300 hover:-translate-y-1 hover:border-accent/50 hover:shadow-2xl hover:shadow-black/40"
      >
        <img
          src="/images/ad-halo/halo-ad-26.jpg"
          alt="Art direction — explore Halo Infinite, DEADROP, and Marathon"
          loading="lazy"
          class="h-full w-full object-cover transition duration-700 group-hover:scale-105"
        />
      </a>
    </div>
  </section>

  <section class="mx-auto max-w-7xl px-6 py-20 lg:px-8">
    <div class="mb-12 flex flex-col gap-4 md:flex-row md:items-end md:justify-between" data-reveal>
      <div>
        <p class="text-sm tracking-[0.2em] uppercase text-accent">Selected work</p>
        <h2 class="mt-2 text-3xl font-semibold tracking-tight">Concept art galleries</h2>
        <p class="mt-3 max-w-xl text-sm leading-relaxed text-muted">
          The craft under the direction — visual development across the franchises I've helped shape.
        </p>
      </div>
      <a href="/concept" class="text-sm text-muted transition hover:text-accent">View all galleries →</a>
    </div>

    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {
        conceptGalleries.map((gallery, index) => (
          <ConceptGalleryTile
            slug={gallery.slug}
            label={gallery.label}
            description={gallery.description}
            staggerIndex={index}
          />
        ))
      }
    </div>
  </section>

  <section class="border-y border-border/60 bg-bg">
    <div class="mx-auto max-w-7xl px-6 py-14 lg:px-8" data-reveal>
      <p class="mb-8 text-center text-xs tracking-[0.25em] uppercase text-muted">Recognition</p>
      <div class="grid gap-8 text-center sm:grid-cols-3">
        <div>
          <p class="text-3xl font-semibold tracking-tight text-accent sm:text-4xl">{gdcTalks}×</p>
          <p class="mt-2 text-sm text-muted">GDC speaker on craft &amp; career (2015–2026)</p>
        </div>
        <div>
          <p class="text-3xl font-semibold tracking-tight text-accent sm:text-4xl">{bookCount}</p>
          <p class="mt-2 text-sm text-muted">Published art books — Star Wars, Halo, Destiny &amp; more</p>
        </div>
        <div>
          <p class="text-3xl font-semibold tracking-tight text-accent sm:text-4xl">{pressOutlets.length}</p>
          <p class="mt-2 text-sm text-muted">Featured in press — {pressOutlets.join(', ')}</p>
        </div>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-7xl px-6 py-20 lg:px-8">
    <div
      class="relative isolate overflow-hidden rounded-2xl border border-border/60 bg-surface-elevated px-8 py-12 text-center sm:px-12"
      data-reveal
    >
      <SectionBackdrop images={ctaBackdrop} opacity={0.12} overlayClass="bg-surface-elevated/85" />
      <div class="relative z-10">
        <h2 class="text-2xl font-semibold tracking-tight">Let's talk</h2>
        <p class="mx-auto mt-4 max-w-xl text-muted">
          Open to art and creative leadership roles and studio conversations. Reach out anytime.
        </p>
        <a
          href="/contact"
          class="mt-8 inline-flex rounded-full border border-border px-6 py-3 text-sm font-medium tracking-wide transition hover:border-accent hover:text-accent"
        >
          Get in touch
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
